  "@type": [
    "skos:ConceptScheme"
  ],
  "skos:prefLabel": "AQ pollutants / measured variables",
  "skos:definition": "Air-quality pollutants and co-measured variables used as schema:propertyID / schema:variableMeasured. Each concept carries skos:exactMatch to the EEA/Eionet AQD pollutant term (AQD canonical identifier) and skos:closeMatch to the corresponding CF standard name (observable quantity). Use these in place of bare term-code strings.",
  "schema:version": "0.1.0",
  "skos:hasTopConcept": [
    {
      "@id": "https://w3id.org/cdif/airquality/vocab/pollutant/PM2.5",
      "@type": [
        "skos:Concept"
      ],
      "skos:prefLabel": "Particulate matter < 2.5 µm",
      "skos:definition": "Mass concentration of particulate matter with aerodynamic diameter < 2.5 µm in ambient air.",
      "skos:inScheme": {
        "@id": "https://w3id.org/cdif/airquality/vocab/pollutant"
      },
      "skos:notation": "PM2.5",
      "skos:altLabel": [
        "PM2.5"
      ],
      "skos:exactMatch": [
        {
          "@id": "http://dd.eionet.europa.eu/vocabulary/aq/pollutant/6001"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_pm2p5_ambient_aerosol_particles_in_air/"
        }
      ],
      "skos:editorialNote": "exactMatch is to the EEA AQD pollutant term (the AQ-domain canonical identifier for the measured pollutant); the CF standard name is closeMatch because it denotes the observable quantity and units (mass concentration in air) rather than the substance. Same pattern applies to the other pollutant concepts."
    },
    {
